# Copy to .env.local for `vercel dev`, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# Set ONE provider key. Groq is free and the fastest option.

GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional
# AI_PROVIDER=groq            # force a provider: groq | gemini | anthropic
# AI_MODEL=                   # override the provider's default model
# ALLOWED_ORIGINS=https://mannsvijay.vercel.app,http://localhost:3000
